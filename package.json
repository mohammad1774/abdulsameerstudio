{
  "name": "abdulsameerstudio",
  "version": "0.1.0",
  "private": true,
  "description": "The Abdul Sameer Studio portfolio website.",
  "type": "module",
  "engines": {
    "node": ">=24.8.0 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:html && npm run lint:styles && npm run lint:scripts",
    "lint:html": "html-validate index.html 404.html",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "lint:scripts": "eslint .",
    "test": "npm run build && npm run test:browser",
    "test:browser": "playwright test",
    "check": "npm run format:check && npm run lint && npm run test",
    "deploy:cloudflare": "wrangler deploy",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "html-validate": "11.5.6",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260722.1": true
  }
}
