{
  "name": "abdulsameerstudio",
  "version": "0.1.0",
  "private": true,
  "description": "The Abdul Sameer Studio portfolio website.",
  "type": "module",
  "engines": {
    "node": ">=24.8.0 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:html && npm run lint:styles && npm run lint:scripts",
    "lint:html": "html-validate index.html 404.html",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "lint:scripts": "eslint .",
    "images:optimize": "node scripts/optimize-images.mjs",
    "test": "npm run build && npm run test:browser",
    "test:browser": "playwright test",
    "check": "npm run format:check && npm run lint && npm run test",
    "deploy:cloudflare": "wrangler deploy",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@playwright/test": "1.63.0",
    "autoprefixer": "10.6.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "html-validate": "11.16.0",
    "postcss": "8.5.28",
    "prettier": "3.9.8",
    "sharp": "0.35.4",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.0",
    "wrangler": "4.134.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260722.1": true
  }
}
